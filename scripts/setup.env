# Shared install/serve defaults. Sourced by scripts; not executed.
QWEN38_MODEL="${QWEN38_MODEL:-unsloth/Qwen3.8-27B-NVFP4}"
QWEN38_OFFICIAL_BF16="${QWEN38_OFFICIAL_BF16:-Qwen/Qwen3.8-27B}"
QWEN38_OFFICIAL_FP8="${QWEN38_OFFICIAL_FP8:-Qwen/Qwen3.8-27B-FP8}"
QWEN38_OFFICIAL_NVFP4_RECIPE="${QWEN38_OFFICIAL_NVFP4_RECIPE:-Inferact/Qwen3.8-27B-NVFP4}"
HF_HOME="${HF_HOME:-${XDG_CACHE_HOME:-$HOME/.cache}/huggingface}"
QWEN38_HOST="${QWEN38_HOST:-127.0.0.1}"
QWEN38_PORT="${QWEN38_PORT:-8000}"
QWEN38_MAX_MODEL_LEN="${QWEN38_MAX_MODEL_LEN:-16384}"
QWEN38_KV_CACHE_DTYPE="${QWEN38_KV_CACHE_DTYPE:-fp8}"
QWEN38_GPU_UTIL="${QWEN38_GPU_UTIL:-0.90}"
UV_CACHE_DIR="${UV_CACHE_DIR:-${XDG_CACHE_HOME:-$HOME/.cache}/uv}"
